extends layout_kor.pug 
block variables 
    -var menuType = 1

block div
    section.jumbotron.jumbotronBg1 
        div.container
            //-p.jumbotronLead LaCalS
    section.jumbotronFooter 
        div.container-fluid
            |All kids have their own stage to PLAY!
    section#content
        div.contentTitleWrap
            div.contentTitle.container-fluid
                |About Lacals
        div.focus.container-fluid
            h2.majorTitle For What
            ul.detail
                li 
                    span 
                        span.textOrange LA
                        |MA 
                    p 히브리어로 'why?'라는 의미이며 질문은 아이들의 풍부한 상상력과 창의력의 시작입니다.
                li
                    span 
                        |GLO
                        span.textOrange CAL
                    p ‘Local’과 ‘Global’의 합성어로, 로컬에서 글로벌로 뻗어나가는 시각과, 글로벌 관점을 로컬에 적용하는 역량을 함께 키웁니다.
                li
                    span 
                        span.textOrange S
                        |TAGE
                    p 모든 아이가 자신의 색깔을 찾아 각자의 무대에서 그 색깔을 마음껏 선보이길 바라는 마음을 담았습니다. 
            p.detail_mobile
                span.textOrange LA
                    span MA
                |는 히브리어로 'why?' 라는 의미입니다. 
                |질문을 통해 글로벌로 뻗어나가는 시각과 글로벌 관점을 로컬에 적용하는 품격있는 
                span GLO
                    span.textOrange CAL
                |인재를 키웁니다. 모든 아이들이 각자의 
                span.textOrange S
                    span TAGE
                |에서 독창성을 발휘하며 한 발 더 도약할 수 있도록 합니다.
            //-p.detail
                |LAMA 
                |히브리어로 why?라는 의미이며 질문은 아이들의 풍부한 상상력과 창의력의 시작입니다.
                br
                |GLOCAL ‘Local’과 ‘Global’의 합성어로 로컬에서 글로벌로 뻗어나가기도, 또 글로벌의 기준과 사고를
                br
                |로컬로 가져와 적용할 수 있는 태도를 가르칩니다.
                br
                |STAGE 모든 아이가 자신의 색깔을 찾아 각자의 무대에서 그 색깔을 마음껏 선보이길 바라는 마음을 담았습니다. 
        div.brandStatement.container-fluid
            h4.subTitle Stage-Based Multilingual Creative Learning Center
            p.detail
            |LaCalS는 아이가 무대 위에서 언어와 감정을 표현하며 성장하는 무대기반 창의융합교육센터입니다. 
            br
            |기초 무대에서 시작해서, 세계와 연결되고, 탐구하며, 자신감을 키우는 성장 여정을 제공합니다.
        div.philosophy.container-fluid
            h4.minorTitle LaCalS의 교육철학
            p.titleIntro
                |All kids have their own stage to PLAY!
        style.
            .philosophy .philosophyList {max-width: 1200px; margin:0 auto; display: flex; justify-content: space-between;}
        div.philosophy.container-fluid
            ul.philosophyList
                li
                    div
                        img(src="./images/philosophyImage1.png")
                    h4 무대 기반 표현력
                    ul
                        li
                            b 정규클래스:
                            |자기 생각 표현하기, 자기주도 창작물
                        li
                            b 테마클래스: 
                            |실 공연, 직접만든 대사, 무대 영상, 과정 사진
                li
                    div
                        img(src="./images/philosophyImage2.png")
                    h4 언어 감각, 사고 유연성
                    div
                        p 내생각을 언어로 풀어내고 다양한 언어로 사고 전환
                        ul 
                            li 다중언어 집중환경 Translanguaging
                            li 스캐폴딩 접근, 수업 피드백 노트 작성 시 아이의 생각과 성장 기록
                li
                    div
                        img(src="./images/philosophyImage3.png")
                    h4 정서 지능, 자기 조절력
                    div
                        p 감정을 인식하고 공감하며, 언어로 감정을 표현
                        ul
                            li - 기질/자기조절력 검사(TCI/SRRS)
                                br 
                                |→ 아이 특성 맞춤 프라이빗 설계
                            li - SEL 프로그램
                            li - 정기 분석 리포트
        div.contentIntroWrap
            div.contentIntro.container-fluid
                |"LaCalS는 아이가 자신의 색깔로 자신만의 무대를 만들어가는 과정을 응원합니다."
        div.keyword.container-fluid
            h4.titleSub Lama · Harpatka · Bitahon
            p.detail '호기심·도전·자신감'을 상징하는 히브리어이며, 각 프로그램에 하브루타 교육 접근법이 녹아있습니다. 아이가 세계 속 다양한 언어와 문화적 맥락을 자연스럽게 접하도록 돕습니다.
        div.keyword.keywordWrap
            ul.keywordList.container-fluid
                li
                    div.keywordListTitle
                        h4 01 정규레슨
                        a 자세히 보기 &gt;
                    a
                        img(src="./images/keywordImage1.png")
                    p.keywordListClassTitle Lama / Harpatka
                    ul.keywordListClassList
                        li 
                            b 형태
                            | 1:1~1:4
                        li 
                            b 수업시간
                            | 60분
                        li 
                            b 주요언어
                            | 다중언어
                li
                    div.keywordListTitle
                        h4 02 테마레슨
                        a 자세히 보기 &gt;
                    a
                        img(src="./images/keywordImage2.png")
                    p.keywordListClassTitle Bitahon / Rhetoric
                    ul.keywordListClassList
                        li 
                            b 형태
                            | 1:2~1:6
                        li 
                            b 수업시간
                            | 60~100분
                        li 
                            b 주요언어
                            | 모국어 기반 언어
                li
                    div.keywordListTitle
                        h4 03 확장클래스
                        a 자세히 보기 &gt;
                    a
                        img(src="./images/keywordImage3.png")
                    p.keywordListClassTitle World Story Atlas
                    ul.keywordListClassList
                        li 
                            b 형태
                            | 1:2~1:6
                        li 
                            b 수업시간
                            | 50분
                        li 
                            b 주요언어
                            | 글로벌 문화기반 영어
        div.byWhom.container-fluid
