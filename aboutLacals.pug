    style.
        #content.container-fluid {}

        .focus {color: #383838;}
        .focus .detail {font-size: 1.6rem; margin-bottom: 3.5rem; word-break: keep-all;}
        .focus .detail_mobile {display:none; font-size: 2.1rem; font-weight: 400; }

        /*각 키워드별 설명 추가*/
        .focus .detail li {display: flex;}
        .focus .detail li span {width: 10rem; font-weight: bold;}
        .focus .detail li p {width: 100%; margin:0; padding:0;}

        .brandStatement {color:#383838; font-size:1.9rem; font-weight: 300;}

        @media (max-width: 1199.98px) {
            .focus {flex-direction: column; padding: 3rem 2rem;}
            .focus .title {margin-bottom: 3rem;}
            .focus .detail {flex-basis: auto; padding:0 2rem;}
        }
        
        @media (max-width: 991.98px) {
            .focus .detail {display: none;}
            .focus .detail_mobile {display: block;}
        }

        .profile {display: flex; gap: 10rem; justify-content: space-between; margin-bottom: 7rem;}
        .profileImage {width: 20%; min-width: 34rem; max-width: 38rem; text-align: right;}
        .profileImage img {width: 100%; max-width:74rem; border-radius: 2rem;}
        .profileText {width: 80%;}
        .profileName {font-size: 2.8rem; color: #1d1d1f; margin-bottom: 4rem;}
        .profileName b {margin-right: 1rem;}
        .profileIntro {line-height: 110%; font-size: 4.2rem; font-family: 'SDMisaeng'; font-style: italic; margin-bottom: 1.8rem;}
        .profileTags {display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 6rem;}
        .profileTags > span {padding: 0.5rem 1rem; font-size: 1.4rem; border-radius: 2rem; box-sizing: border-box; background-color: #1d1d1f; color:#fff;}

        .profileContent {}
        .profileContentTitle {font-size:2.4rem; font-weight: 600; color: #333; margin-bottom: 1rem;}
        .profileContentList {font-size: 2.2rem; margin-bottom: 2.4rem;}
        .profileContentList > li {padding-left: 2rem;}
        .profileContentList > li > ul > li {padding-left: 2rem; font-size: 1.8rem; color: #333;}

        /*불렛 효과*/
        .profileContentTitle {position: relative; padding-left: 0rem;}
        .profileContentTitle:after {position: absolute; content:''; width: 1.2rem; height: 1.2rem; border-radius: 50%; background-color:#f15c22; left: -2.3rem; top: 0.7rem;}

        /*profile별 특이사항 */
        .profileTheme3 .profileImage img {max-width:26rem;}
        .profileTheme4 .profileImage img {max-width:24rem;}
        .profileTheme1 .profileContentList > li {position: relative;}
        .profileTheme1 .profileContentList > li:after {content: '\2713'; position: absolute; color:#f15c22; opacity: 0.5; left: -0.2rem; top: 0.1rem; font-size: 1.8rem;}
        .profileTheme1 .profileContentList > li span {font-style: italic; font-weight: 300; font-size: 1.6rem; margin-left: 0.2rem;}
