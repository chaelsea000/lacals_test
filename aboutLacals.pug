        @media (max-width: 1199.98px) {
            .profile {flex-direction: column; gap: 0; text-align: center;}
            .profileName {margin-top: 1.8rem;}
            .profileTags {justify-content: center;}
            .profileImage {width: 100%; padding:0; margin: 0 auto; text-align: center;}
            .profileText {width: 100%;}
            .profileContent {padding-left: 4rem; text-align: left;}
