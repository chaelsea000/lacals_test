extends layout_kor.pug 
block variables 
    -var menuType = 1

block div
    section.jumbotron.jumbotronBg1 
        div.container
            //-p.jumbotronLead LaCalS
    section.jumbotronFooter
        div.container-fluid
            |All kids have their own stage to PLAY!
    section#content
        div.lesson.lessonTheme1.container-fluid
            h2.majorTitle 정규레슨
            p.introTitle 사고의 유연성을 길러 세계 어디서든 품격을 갖춘 글로벌 인재 육성을 목표로 합니다.
            ul.lessonList
                li 
                    h4.lessonListTitle 클래스 라마 (Class Lama)
                    p.lessonListIntro 창의융합 놀이교육
                    div.lessonListImgWrap
                        img(src="./images/lessonList1.png")
                    ul.lessonListContent 
                        li 
                            b 인원
                            p 개인 / 그룹(정원 2명)
                        li 
                            b 시간
                            p 1회 60분, 월~금
                        li 
                            b 등록
                            p 최소 10회, 최대 30회 등록 가능
                                span *1개 프로그램당 기본 10회기 구성
                        li 
                            b 대상
                            p 최소 연령 제한 없음
                                span *앉을 수 있고 분리 가능 아동 
                                    br
                                    |라칼스 입문
                        li 
                            b 구성
                            p STEAM, 그림책, 인지발달/정서지능 기반 창의/창작 놀이 활동
                        li 
                            b 주요언어
                            p 한국어, 영어, 스페인어, 기타 언어
                li 
                    h4.lessonListTitle 클래스 하르팟카 (Class Harpatka)
                    p.lessonListIntro 사고 확장 및 표현력 향상 교육
                    div.lessonListImgWrap
                        img(src="./images/lessonList2.png")
                    ul.lessonListContent 
                        li 
                            b 인원
                            p 소수정예(정원 4명)
                        li 
                            b 시간
                            p 1회 60분, 월~토
                        li 
                            b 등록
                            p 최소 10회, 최대 30회 등록 가능
                                span *1개 프로그램당 기본 10회기 구성
                        li 
                            b 대상
                            p 최소 만 4세 이상       
                                span 라칼스 심화
                        li 
                            b 구성
                            p 분야별 탐구활동, 문학/비문학, STEAM x 사고력, 창작활동 x 토론, 사회적학습(SEL) 등
                        li 
                            b 주요언어
                            p 한국어, 영어
        hr
        div.lesson.lessonTheme2.container-fluid
            h2.majorTitle 테마 레슨
            p.introTitle 하브루타식 자기주도 활동을 통해 다양한 직·간접 경험을 하며 세상을 바라보는 시야 확장을 도모합니다.
            div.lessonListItem
                h3.lessonListTitle 클래스 비타혼 (Class Bitahon)
                p.lessonListIntro 자기주도 창작 교육 & 무대 경험
                ul.lessonListItemList
                    li 
                        h4.lessonListItemListTitle 01. SEL- 하브루타 연극
                        p.lessonListItemListIntro (SEL-chavruta theatre) 영국 정통 연극연출가와 함께하는 자기주도 연극 프로그램
                        div.lessonListImgWrap
                            img(src="./images/lessonList3.png")
                        ul.lessonListContent 
                            li 
                                b 인원
                                p 소수정예(정원 6명)
                            li 
                                b 시간
                                p 90-100분
                            li 
                                b 등록
                                p 프로젝트별 등록
                                    span *그룹별 회차 상이
                            li 
                                b 대상
                                p 정규 레슨 최소 1개 프로그램 이수자
                                    br
                                    |최소 만 4세 이상
                            li 
                                b 구성
                                p 그림책부터 클래식 문학까지 다양한 장르를 다각도로 해석하고 
                                    |아이의 색깔로 무대에서 표현하는 경험. 역할 선정, 대본 작성, 
                                    |소품 및 무대 제작 등모든 과정을 단계별로 직접 참여하며 연극
                                    |을 완성. 실제 연극 배우, 의상디자이너, 무대 감독, 조명 감독 
                                    |등 특강
                            li 
                                b 주요언어
                                p 영어
                    li 
                        h4.lessonListItemListTitle 02. 드라마 & 스피치 (Drama & Speech)
                        p.lessonListItemListIntro 국제 무대 경험
                        div.lessonListImgWrap
                            img(src="./images/lessonList4.png")
                        ul.lessonListContent 
                            li 
                                b 인원
                                p 개인 / 그룹(정원 2명)
                            li 
                                b 시간
                                p 1회 60분, 월~토
                            li 
                                b 등록
                                p 10회(기본과정), 20회(기본+심화과정)
                            li 
                                b 대상
                                p 정규 레슨 최소 3개 프로그램 이수자
                                    br
                                    |연극 클래스 최소 1개 프로젝트 이수자 또는 동시 등록자
                            li 
                                b 구성
                                p 창작 글쓰기, 발표 태도, 발음, 표정, 감정 이입 등
                            li 
                                b 주요언어
                                p 한국어, 영어
            div.lessonListItem
                h3.lessonListTitle 클래스 레토릭 (Class Rhetoric)
                p.lessonListIntro 자기주도 고차 사고 기반 표현력 향상 프로그램: 말과 글로 표현하는 올인원 문학 수업
                ul.lessonList
                    li 
                        div.lessonListImgWrap
                            img(src="./images/lessonList5.png")
                        ul.lessonListContent 
                            li 
                                b 인원
                                p 소수정예(정원 4명)
                            li 
                                b 시간
                                p 1회 60분, 월~토
                            li 
                                b 등록
                                p 최소 10회, 최대 30회 등록 가능
                                    span *1개 프로그램당 기본 10회기 구성
                            li 
                                b 대상
                                p 클래스 하르팟카 최소 5개 프로그램 이수자
                                    br
                                    |클래스 비타혼 최소 3개 프로그램 이수자
                                    br
                                    |선발 테스트 有
                            li 
                                b 구성
                                p 문학/비문학 분석, 토론, 발표 글쓰기 등
                            li 
                                b 주요언어
                                p 영어
        hr
        div.lesson.lessonTheme3.container-fluid
            h2.majorTitle 확장클래스
            ul.lessonList
                li 
                    h4.lessonListTitle 월드스토리아틀라스
                        br.mob
                        | (World Story Atlas: WSA)
                    p.lessonListIntro 그림책으로 떠나는 세계 여행
                    div.lessonListImgWrap
                        img(src="./images/lessonList6.png")
                    ul.lessonListContent 
                        li 
                            b 인원
                            p 그룹(정원 4명)

                        li 
                            b 시간
                            p 1회 50분
                        li 
                            b 등록
                            p 최초 등록 8회    
                                span *전체 20주 과정
                        li 
                            b 대상
                            p 4세 ~ 7세
                        li 
                            b 구성
                            p 세계 다양한 그림책, 사고력 질문 기반 문화, 역사, 예술 등 관련 연계 활동
                        li 
                            b 주요언어
                            p 영어
        div.contactInfoWrap
            div.contactInfo
                |※ 외부강의 및 기관 협업
                br
                |이메일(postmaster@lacals.com) 별도 문의


    style.
        hr {display: none; margin: 0; border-top:0;}
        #content {margin-bottom: 20.5rem;}
        /*html구조 통일성이 없어서 .lesson, .lessonList, .lessonListContent를 하위속성이 아닌 개별로 선언*/
        .lesson {}
        .lesson .majorTitle {margin-bottom: 0.5rem; font-size: 3rem; font-weight: 500;}
        .lesson .introTitle {font-size: 1.7rem; line-height: 140%;}
        
        .lessonList {margin:0 auto; display: flex; justify-content: space-between;}
        .lessonList > li {}

        .lessonListTitle {margin-bottom: 1rem; font-size: 3.2rem; font-weight: bold; font-family: 'SUIT'; color: #006c67;}
        .lessonListIntro {margin-bottom: 5rem; font-size: 1.7rem; font-weight: normal; font-family: 'SUIT'; color: #383838;}
        .lessonListImgWrap {}
        .lessonListImgWrap img {width: 100%;}
        
        .lessonListContent {margin-top: 4.5rem;}
        .lessonListContent > li {display: flex; font-size: 1.8rem; color: #383838;}
        .lessonListContent > li b {display: inline-block; min-width: 8rem; font-weight: bold;}
        .lessonListContent > li p {margin-bottom: 0;}
        .lessonListContent > li span {display: block; font-style: italic;}

        .contactInfoWrap {background-color: #ff5e00;}
        .contactInfo {padding: 3.4rem 0; font-size: 1.6rem; font-weight: 600; font-family: 'SUIT'; text-align: center; color: white;}
        
        .lessonTheme2 .lessonListItem {margin-bottom: 7rem;}
        .lessonTheme2 .lessonListItemList {margin:0 auto; display: flex; justify-content: space-between;}        
        .lessonTheme2 .lessonListItemList > li {}
        .lessonTheme2 .lessonListItemListTitle {margin-bottom: 1rem; font-size: 2.4rem; font-weight: bold; font-family: 'SUIT'; color: #383838;}      
        .lessonTheme2 .lessonListItemListIntro {margin-bottom: 5.5rem; font-size: 1.4rem; font-weight: 600; font-family: 'SUIT'; color: #383838;}
        
        @media (max-width: 1199.98px) {
            hr {margin: 0; border-top:0; border: 7px solid #006C67;}
            .lessonList {flex-direction: column;}
            .lessonList > li {padding: 0; padding-top: 3.2rem; padding-bottom: 7.3rem;}

            .lessonListTitle {margin-bottom: 0rem; font-size: 2.2rem; font-weight: 600;}
            .lessonListIntro {margin-bottom: 3.6rem;}

            .lessonListContent {margin-top: 2.2rem;}
            .lessonListContent > li {font-size: 1.6rem; line-height: 120%; padding: 0.35rem 0; font-weight: 500;}
            .lessonTheme1 .lessonList > li {border-top: 1px solid #898989;}
            .lessonTheme2 .majorTitle {margin-top: 7.6rem;}
            .lessonTheme3 .majorTitle {margin-top: 7rem;}

            .lessonTheme2 .lessonListItem:first-of-type {margin-bottom: 3.4rem;} /*클래식레토릭 이전*/
            .lessonTheme2 .lessonListItem:last-of-type .lessonList > li {padding: 0;}
            .lessonTheme2 .lessonListItemList {flex-direction: column;}
            .lessonTheme2 .lessonListItemList > li {border-top: 1px solid #898989; padding-top: 3.6rem; padding-bottom: 4.4rem;}
            .lessonTheme2 .lessonListItemList > li:last-child {border-bottom: 1px solid #898989;}
            .lessonTheme2 .lessonListItemListTitle {font-size: 1.9rem; margin-bottom: 0.5rem; font-weight: 800;}
            .lessonTheme2 .lessonListItemListIntro {margin-bottom: 3.2rem; font-weight: 500;}
        }
        
        @media (max-width: 991.98px) {
        }